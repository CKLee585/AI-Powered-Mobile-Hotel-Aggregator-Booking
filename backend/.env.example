HEREWEGO_ENVIRONMENT=development
HEREWEGO_DATA_MODE=mock
HEREWEGO_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# HEREWEGO_DATABASE_PATH=/absolute/path/to/herewego.db

# Add real credentials only to a local .env file or secret manager.
# Never place these values in Flutter source code or commit them to Git.
HEREWEGO_GOOGLE_VISION_API_KEY=
HEREWEGO_GOOGLE_PLACES_API_KEY=
